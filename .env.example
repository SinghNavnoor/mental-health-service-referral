# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# Shared secret. The HubSpot workflow sends this as the `x-webhook-secret` header.
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=your_webhook_secret_here

# PandaDoc API key (Settings -> API & Integrations -> API Keys)
PANDADOC_API_KEY=your_pandadoc_api_key_here

# Address that receives the assembled PandaDoc referral document
REFERRAL_TO_EMAIL=provider@example.org

# UUID of the Clinical Referral Form template in your PandaDoc workspace
CLINICAL_REFERRAL_TEMPLATE_UUID=your_pandadoc_template_uuid_here

# Address printed in the generated cover-page footer
CLINICAL_FORM_CONTACT_EMAIL=clinic@example.org

# Organization name rendered on the generated cover page
ORG_NAME=Example Housing Services
